          "scriptActive": true,
          "script": {
            "owneremails": {
              "scriptActive": true,
              "script": "/*\n**Access Flow/Action data using the fd_data object. Script must return a value. \n**Order number is offset by +1 in Error Handling Section.\n**Available options display upon pressing \".\" after fd_data\n**example: var shortDesc = fd_data.trigger.current.short_description;\n**return shortDesc;\n*/\n\nvar members = fd_data._13__look_up_m365_groups_by_site_permission.usersgroupslist;                                                                                                                        \nmembers = (typeof members === 'string') ? JSON.parse(members) : members;                                                                                                                           \n                                                                                                                                                                                                     \nvar humanEmails = [];\n\nfor (var i = 0; i < members.length; i++) {\n    var member = members[i];\n    if (\n        member.principalType === 1 &&\n        member.userPrincipalName !== null &&\n        member.email !== null &&\n        member.email.trim() !== '' \n    ) {\n        humanEmails.push(member.email.trim());\n    }\n}\n\nreturn humanEmails.join(', ');"
            }
          }
        }
      ],
