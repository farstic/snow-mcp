{
  "spec_version": "1",
  "flow": { "key": "record_actions", "name": "Record Actions", "description": "Construct spec: record, attachment, task, wait, event, SMS, email and notification actions with for each loops", "run_as": "system" },
  "trigger": { "key": "rec_trigger", "type": "record.updated", "table": "incident", "condition": "active=false", "run_flow_in": "background" },
  "steps": [
    { "kind": "action", "key": "rec_context_note", "action": "addWorknoteLinkToContext", "annotation": "Link the flow context",
      "inputs": { "table": "incident", "record": { "pill": "trigger.current" }, "journal_field": "work_notes", "additional_comments": "Flow context attached" } },
    { "kind": "action", "key": "rec_find_atts", "action": "getAttachmentsOnRecord",
      "inputs": { "source_record": { "text": "{{trigger.current}}" }, "file_name": "evidence.zip" } },
    { "kind": "for_each", "key": "rec_each_att", "items": { "pill": "steps.rec_find_atts.parameter" }, "steps": [
      { "kind": "action", "key": "rec_copy_att", "action": "copyAttachment",
        "inputs": { "table": "problem", "target_record": { "pill": "trigger.current.problem_id" }, "attachment_record": { "pill": "loop.rec_each_att.item" } } },
      { "kind": "action", "key": "rec_move_att", "action": "moveAttachment",
        "inputs": { "table": "problem", "target_record": { "pill": "trigger.current.problem_id" }, "source_attachment_record": { "pill": "loop.rec_each_att.item" } } }
    ] },
    { "kind": "action", "key": "rec_one_att", "action": "lookupAttachment",
      "inputs": { "source_record": { "pill": "trigger.current" }, "file_name": "summary.txt" } },
    { "kind": "action", "key": "rec_att_row", "action": "lookUpRecord",
      "inputs": { "table": "sys_attachment", "conditions": { "conditions": "sys_id={{steps.rec_one_att.parameter}}" }, "sort_column": "size_bytes",
                  "sort_type": "sort_asc", "if_multiple_records_are_found_action": "error", "dont_fail_on_error": true } },
    { "kind": "action", "key": "rec_drop_named", "action": "deleteAttachment",
      "inputs": { "table": "incident", "record": { "pill": "trigger.current" }, "delete_all_": false, "attachment_file_name": { "text": "{{steps.rec_att_row.Record.file_name}}" } } },
    { "kind": "action", "key": "rec_drop_all", "action": "deleteAttachment",
      "inputs": { "table": "incident", "record": { "pill": "trigger.current" }, "delete_all_": true } },
    { "kind": "action", "key": "rec_upsert_user", "action": "createOrUpdateRecord",
      "inputs": { "table_name": "sys_user", "fields": { "template": { "email": { "pill": "trigger.current.caller_id.email" }, "first_name": "Sample", "last_name": "Caller", "active": true } } } },
    { "kind": "action", "key": "rec_close_children", "action": "updateMultipleRecords",
      "inputs": { "table_name": "incident", "conditions": { "conditions": "parent_incident={{trigger.current.sys_id}}^active=true" },
                  "field_values": { "template": { "state": 6, "active": false, "close_code": "Solution provided", "close_notes": "Resolved with the parent incident", "assigned_to": { "pill": "steps.rec_upsert_user.record" } } },
                  "sort_column": "number", "sort_type": "sort_asc", "dont_fail_on_error": false } },
    { "kind": "action", "key": "rec_new_task", "action": "createTask",
      "inputs": { "task_table": "incident_task", "wait": false,
                  "field_values": { "template": { "parent": { "pill": "trigger.current.sys_id" }, "short_description": "Confirm the fix with the caller", "assignment_group": { "pill": "trigger.current.assignment_group" }, "priority": 3 } } } },
    { "kind": "action", "key": "rec_wait_task", "action": "waitForCondition",
      "inputs": { "table_name": "incident_task", "record": { "text": "{{steps.rec_new_task.Record}}" }, "conditions": "state=3",
                  "timeout_flag": true, "timeout_duration": { "duration": { "days": 1, "hours": 6 } }, "timeout_schedule": "08fcd0830a0a0b2600079f56b1adb9ae" } },
    { "kind": "action", "key": "rec_event", "action": "fireEvent",
      "inputs": { "event_name": "incident.updated", "table": "incident", "record": { "text": "{{trigger.current}}" },
                  "parm1": { "text": "{{steps.rec_wait_task.state}}" }, "parm2": { "text": "{{steps.rec_close_children.count}}" } } },
    { "kind": "action", "key": "rec_wait_msg", "action": "waitForMessage",
      "inputs": { "message": "caller-confirmed", "enable_timeout": true, "timeout": { "duration": { "hours": 8 } } } },
    { "kind": "action", "key": "rec_sms", "action": "sendSms",
      "inputs": { "recipients": { "text": "{{trigger.current.caller_id.mobile_phone}}" }, "message": { "text": "Update: {{steps.rec_wait_msg.payload}}" } } },
    { "kind": "action", "key": "rec_mail", "action": "sendEmail",
      "inputs": { "ah_to": { "pill": "trigger.current.caller_id.email" }, "ah_cc": "desk@example.com", "ah_bcc": "audit@example.com",
                  "ah_subject": { "text": "Closed: {{trigger.current.number}}" }, "ah_body": "<p>The incident is closed.</p>", "watermark_email": true,
                  "record": { "pill": "trigger.current" }, "table_name": "incident" } },
    { "kind": "action", "key": "rec_notify", "action": "sendNotification",
      "inputs": { "notification": "0000000000000000000000000000a002", "record": { "pill": "steps.rec_mail.email" }, "table_name": "sys_email" } },
    { "kind": "action", "key": "rec_tasks", "action": "lookUpRecords",
      "inputs": { "table": "incident_task", "conditions": { "conditions": "parent={{trigger.current.sys_id}}^state=7" }, "max_results": 10, "sort_column": "sys_created_on", "sort_type": "sort_asc" } },
    { "kind": "for_each", "key": "rec_each_task", "items": { "pill": "steps.rec_tasks.Records" }, "steps": [
      { "kind": "action", "key": "rec_delete_task", "action": "deleteRecord", "inputs": { "record": { "text": "{{loop.rec_each_task.item}}" } } }
    ] }
  ]
}
