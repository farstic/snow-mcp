{
  "spec_version": "1",
  "flow": {
    "key": "trg_service_catalog",
    "name": "Trigger Service Catalog",
    "description": "Construct spec: catalog.service_catalog trigger"
  },
  "trigger": {
    "key": "trg_service_catalog_trigger",
    "type": "catalog.service_catalog",
    "run_flow_in": "foreground"
  },
  "steps": [
    {
      "kind": "action",
      "key": "trg_service_catalog_log",
      "action": "log",
      "inputs": {
        "log_level": "info",
        "log_message": {
          "text": "Requested item {{trigger.request_item.number}} in {{trigger.table_name}}"
        }
      }
    }
  ]
}
